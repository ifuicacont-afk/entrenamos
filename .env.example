# Datos del proyecto de Supabase.
# Estan en: Project Settings -> API Keys
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# La llave PUBLICA (publishable key), la que empieza con sb_publishable_
# Es publica por diseno: viaja dentro de la app.
# NUNCA pongas aca la secret key (sb_secret_) ni la service_role.
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxx

# Codigo que hay que escribir para poder crear una cuenta.
# Si lo dejas vacio, cualquiera con el link puede registrarse.
VITE_CODIGO_INVITACION=
